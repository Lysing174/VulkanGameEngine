    ivec2 tileMax = ivec2(clamp((pixelCenter + radius + 15.0) / 16.0, vec2(0.0), vec2(tileGrid)));
    if (any(lessThanEqual(tileMax, tileMin)))
        return false;
    vec2 ndcMin = vec2(tileMin * 16) / viewport * 2.0 - 1.0;
    vec2 ndcMax = vec2(tileMax * 16) / viewport * 2.0 - 1.0;

    // alpha >= threshold iff q <= 2*log(opacity/threshold). Keep the original
    // tile domain as well, so the compact geometry cannot introduce new tails.
    float supportRadiusSquared = 2.0 * log(g.posAndOpacity.w / frameInfo.extraInfo.x) + 0.0002;
    vec3 conic = vec3(d, -b, a) / determinant;
    vec2 quadCenter;
    vec4 compactBasis;
    vec4 compactBounds;
    if (!makeCompactQuad(ndcCenter.xy, conic, supportRadiusSquared, viewport, vec4(ndcMin, ndcMax),
        quadCenter, compactBasis, compactBounds))
        return false;

    // Only surviving splats need the fragment shader's ellipsoid parameters.
    // Original preparation retained; the current LMG rule only needs the center depth.
