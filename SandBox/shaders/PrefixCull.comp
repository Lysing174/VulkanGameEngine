    // Conservative AABB of the actual generated quad, not a center-only test.
    vec2 extent = abs(basis1) + abs(basis2);
    if (any(lessThan(ndcCenter.xy + extent, vec2(-1.0))) ||
        any(greaterThan(ndcCenter.xy - extent, vec2(1.0))))
        return false;
    */

    // Match CUDA getRect: ceil(3 sigma) radius, expanded to exclusive 16x16 tile bounds.
    float term = sqrt(max(0.1, halfTrace * halfTrace - determinant));
    float radius = ceil(3.0 * sqrt(halfTrace + term));
