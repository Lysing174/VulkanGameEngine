#version 460

layout(local_size_x = 512) in;

// Prefix pipeline descriptor contract (set 0, shared pipeline layout):
// b0 FrameInfo UBO, b1 Gaussian SSBO, b2 model transforms,
// b3 projected splats (128 bytes/input), b4 scratch (8 bytes/input),
// b5 group counts/offsets (8 bytes/group), b6 work info (64 bytes),
// b7 output keys[0], b8 output values[0], b9 sampled Hi-Z pyramid.
// Bind b1 to exactly N GaussianDataGPU entries. Allocate b3/b4/b7/b8 for N
// entries and b5 for ceil(N/512). Dispatch ceil(N/512), then a compute
// write -> compute read/write barrier before PrefixScan (one workgroup).
// CPU initializes b6 counts.zw to N and ceil(N/512) before the first Cull.
// PrefixScan and PrefixCompact take N in their 16-byte push constants.
// No buffers need clearing. N=0 skips Cull/Compact but must still run Scan.

layout(push_constant) uniform CameraData
{
    mat4 viewMatrix;
    mat4 projectionMatrix;
} camera;

layout(std140, set = 0, binding = 0) uniform FrameInfo
{
    vec4 cameraPosAndScale;
    vec4 focal;
    vec4 viewportInfo;
    vec4 extraInfo; // x: alpha threshold; y: Hi-Z active; z: adaptive refinement enabled.
} frameInfo;

struct GaussianDataGPU
{
    vec4 posAndOpacity;
    float sh[48];      // 完整三阶球谐系数 (16 基函数 × 3 通道), 由 shader 实时求值
    float cov3d[6];
    uint modelIndex;
    float _pad1;
};

struct ProjectedSplatGPU
{
    vec4 ndcCenter;   // xyz = center/depth; w = 1, matching the existing VS.
    vec4 ndcBasis;    // xy = first basis; zw = second basis, in NDC units.
    vec4 color;       // rgb + base opacity.
    vec4 viewCenter;  // xyz = view-space center; w = unused.
    vec4 quadCenter;  // xy = quad center in NDC; z = needs tile-domain fragment rejection.
    vec4 tileBounds;  // original tile candidate rectangle in NDC (old ellipsoid slot).
    vec4 conic;       // inverse screen covariance: (xx, xy, yy); w = conservative power cutoff.
    vec4 ndcBounds;   // conservative contributing-pixel AABB, within the original tile bounds.
};

layout(std430, set = 0, binding = 1) readonly buffer GaussianDataBuffer
{
    GaussianDataGPU gaussians[];
};

layout(std430, set = 0, binding = 2) readonly buffer ModelTransformBuffer
{
    mat4 modelTransforms[];
};

layout(std430, set = 0, binding = 3) writeonly buffer ProjectedSplatBuffer
{
    ProjectedSplatGPU projectedSplats[];
};

layout(std430, set = 0, binding = 4) writeonly buffer PrefixScratchBuffer
{
    uvec2 prefixScratch[]; // x = encoded view z; y = local rank or UINT_MAX.
};

layout(std430, set = 0, binding = 5) writeonly buffer PrefixGroupBuffer
{
    uvec2 groupData[]; // x: after Hi-Z, y: before Hi-Z.
};

layout(std430, set = 0, binding = 6) readonly buffer GaussianWorkInfoBuffer
{
    uvec4 counts; // visibleCount, sortPartitionCount, inputCount, inputGroups.
    uvec4 sortDispatch;
    uvec4 draw;
    uvec4 cullingCounts;
} workInfo;

layout(set = 0, binding = 9) uniform sampler2D hiZDepth;

const float SQRT8 = 2.8284271247461903;
const uint INVALID_RANK = 0xFFFFFFFFu;
shared uvec2 visiblePrefix[512];

bool makeCompactQuad(vec2 center, vec3 conic, float radiusSquared, vec2 viewport, vec4 tileBounds,
    out vec2 quadCenter, out vec4 basis, out vec4 clipBounds)
{
    // The original rectangle is a safe fallback for ill-conditioned conics.
    clipBounds = tileBounds;
    quadCenter = (tileBounds.xy + tileBounds.zw) * 0.5;
    basis = vec4((tileBounds.z - tileBounds.x) * 0.5, 0.0,
        0.0, (tileBounds.w - tileBounds.y) * 0.5);

    float coefficientScale = max(max(abs(conic.x), abs(conic.y)), abs(conic.z));
    if (!(coefficientScale > 0.0) || isnan(coefficientScale) || isinf(coefficientScale))
        return true;

    vec3 q = conic / coefficientScale;
    // Enlarge the ellipse to cover roundoff in the fragment quadratic form.
    // Subtracting a multiple of I preserves the principal directions.
    float roundoff = 4e-6 * (abs(q.x) + 2.0 * abs(q.y) + abs(q.z));
    q.xz -= vec2(roundoff);
    float determinant = q.x * q.z - q.y * q.y;
    if (q.x <= 0.0 || q.z <= 0.0 || determinant <= 0.0)
        return true;

    float halfDifference = 0.5 * (q.x - q.z);
    float eigenGap = length(vec2(halfDifference, q.y));
    float lambdaMax = 0.5 * (q.x + q.z) + eigenGap;
    // det/lambdaMax avoids cancellation in the smaller eigenvalue.
    float lambdaMin = determinant / lambdaMax;
    if (!(lambdaMin > 0.0))
        return true;

    vec2 minorAxis = vec2(1.0, 0.0);
    if (eigenGap > 0.0) {
        minorAxis = q.x >= q.z ? vec2(lambdaMax - q.z, q.y) : vec2(q.y, lambdaMax - q.x);
        minorAxis = normalize(minorAxis);
    }
    vec2 majorAxis = vec2(-minorAxis.y, minorAxis.x);
    vec2 halfLengths = sqrt(vec2(radiusSquared / lambdaMin, radiusSquared / lambdaMax) / coefficientScale);
    // Cover subpixel rasterization and interpolation rounding; never cap large splats.
    halfLengths += vec2(0.5) + halfLengths * 1e-5;
    vec2 basis1 = majorAxis * halfLengths.x * (2.0 / viewport);
    vec2 basis2 = minorAxis * halfLengths.y * (2.0 / viewport);
    vec4 rotatedBasis = vec4(basis1, basis2);
    if (any(isnan(rotatedBasis)) || any(isinf(rotatedBasis)))
        return true;

    // Exact AABB of the enlarged ellipse, with an extra pixel of conservative slack.
    vec2 extent = sqrt(basis1 * basis1 + basis2 * basis2) + 2.0 / viewport;
    clipBounds = vec4(max(tileBounds.xy, center - extent), min(tileBounds.zw, center + extent));
    if (any(lessThanEqual(clipBounds.zw, clipBounds.xy)))
        return false;

    vec2 size = clipBounds.zw - clipBounds.xy;
    float rotatedArea = 4.0 * abs(basis1.x * basis2.y - basis1.y * basis2.x);
    if (size.x * size.y <= rotatedArea) {
        quadCenter = (clipBounds.xy + clipBounds.zw) * 0.5;
        basis = vec4(size.x * 0.5, 0.0, 0.0, size.y * 0.5);
    } else {
        quadCenter = center;
        basis = rotatedBasis;
    }
    return true;
}

const float HIZ_REFINE_MIN_PIXELS = 4096.0;
const uint HIZ_REFINE_NODE_BUDGET = 32u;

float ellipseQuadratic(vec2 p, vec3 q)
{
    return q.x * p.x * p.x + 2.0 * q.y * p.x * p.y + q.z * p.y * p.y;
}

bool outsideEllipse(ivec2 pixelMin, ivec2 pixelMax, vec2 center, vec3 q, float radiusSquared)
{
    // Use whole pixel squares, not only centers, to retain boundary coverage.
    vec2 lo = vec2(pixelMin) - center;
    vec2 hi = vec2(pixelMax) + 1.0 - center;
    if (all(lessThanEqual(lo, vec2(0.0))) && all(greaterThanEqual(hi, vec2(0.0))))
        return false;

    // The minimum of a positive-definite quadratic over a rectangle lies at
    // its center (if contained), or at a clamped minimum on one of four edges.
    vec2 edgeY = clamp(-q.y * vec2(lo.x, hi.x) / q.z, vec2(lo.y), vec2(hi.y));
    vec2 edgeX = clamp(-q.y * vec2(lo.y, hi.y) / q.x, vec2(lo.x), vec2(hi.x));
    float minimum = min(min(ellipseQuadratic(vec2(lo.x, edgeY.x), q),
                            ellipseQuadratic(vec2(hi.x, edgeY.y), q)),
                        min(ellipseQuadratic(vec2(edgeX.x, lo.y), q),
                            ellipseQuadratic(vec2(edgeX.y, hi.y), q)));
    vec2 magnitude = max(abs(lo), abs(hi));
    float magnitudeBound = q.x * magnitude.x * magnitude.x
        + 2.0 * abs(q.y) * magnitude.x * magnitude.y + q.z * magnitude.y * magnitude.y;
    // Treat numerical uncertainty as intersection, including overflow/NaN.
    float slack = max(0.0001 * radiusSquared, 1e-5 * magnitudeBound);
    return minimum > radiusSquared + slack;
}

bool refineOcclusion(ProjectedSplatGPU projected, ivec2 pixelMin, ivec2 pixelMax,
    int rootLevel, ivec2 rootMin, ivec2 rootMax, vec4 rootDepths, float depthGuard)
{
    vec3 conic = projected.conic.xyz;
    float scale = max(max(abs(conic.x), abs(conic.y)), abs(conic.z));
    if (!(scale > 0.0) || isnan(scale) || isinf(scale))
        return false;
    vec3 q = conic / scale;
    float roundoff = 4e-6 * (abs(q.x) + 2.0 * abs(q.y) + abs(q.z));
    q.xz -= vec2(roundoff);
    float determinant = q.x * q.z - q.y * q.y;
    float radiusSquared = (-2.0 * projected.conic.w) / scale;
    if (q.x <= 0.0 || q.z <= 0.0 || determinant <= 0.0 ||
        !(radiusSquared > 0.0) || isnan(radiusSquared) || isinf(radiusSquared))
        return false;

    vec2 center = (projected.ndcCenter.xy * 0.5 + 0.5) * frameInfo.viewportInfo.xy;
    float gaussianDepth = -projected.viewCenter.z;

    // One valid visible pixel is enough to retain the entire Gaussian. Failed
    // samples never establish occlusion; the hierarchy must still prove it.
    ivec2 probe = clamp(ivec2(floor(clamp(center, vec2(pixelMin), vec2(pixelMax)))), pixelMin, pixelMax);
    vec2 d = center - (vec2(probe) + 0.5);
    float power = -0.5 * (conic.x * d.x * d.x + conic.z * d.y * d.y) - conic.y * d.x * d.y;
    if (power <= 0.0 && min(0.99, projected.color.a * exp(power)) >= frameInfo.extraInfo.x) {
        float probeDepth = texelFetch(hiZDepth, probe, 0).r;
        if (gaussianDepth <= probeDepth + 0.1)
            return false;
    }

    // Charge the original four reads and the probe to the same total budget.
    uint visits = 5u;
    for (int rootY = rootMin.y; rootY <= rootMax.y; ++rootY) {
        for (int rootX = rootMin.x; rootX <= rootMax.x; ++rootX) {
            ivec2 node = ivec2(rootX, rootY);
            int level = rootLevel;
            for (;;) {
                if (level != rootLevel) {
                    if (visits >= HIZ_REFINE_NODE_BUDGET)
                        return false;
                    ++visits;
                }
                ivec2 lo = max(pixelMin, node << level);
                ivec2 hi = min(pixelMax, ((node + 1) << level) - 1);
                bool descend = false;
                if (all(lessThanEqual(lo, hi)) && !outsideEllipse(lo, hi, center, q, radiusSquared)) {
                    int rootIndex = (rootX - rootMin.x) + 2 * (rootY - rootMin.y);
                    float depth = level == rootLevel ? rootDepths[rootIndex] : texelFetch(hiZDepth, node, level).r;
                    if (!(gaussianDepth > depth + 0.1 + depthGuard)) {
                        if (level == 0)
                            return false;
                        descend = true;
                    }
                }
                if (descend) {
                    node <<= 1;
                    --level;
                    continue;
                }

                // Stackless depth-first walk: coordinate parity identifies the
                // current child. Ascend until a sibling exists, or finish this root.
                bool hasSibling = false;
                while (level < rootLevel) {
                    int child = (node.x & 1) + 2 * (node.y & 1);
                    ivec2 parent = node >> 1;
                    if (child < 3) {
                        int nextChild = child + 1;
                        node = (parent << 1) + ivec2(nextChild & 1, nextChild >> 1);
                        hasSibling = true;
                        break;
                    }
                    node = parent;
                    ++level;
                }
                if (!hasSibling)
                    break;
            }
        }
    }
    // Every potentially contributing region was either outside the ellipse or
    // proven occluded. Partial visibility and budget exhaustion return above.
    return true;
}

bool isOccluded(ProjectedSplatGPU projected)
{
    if (frameInfo.extraInfo.y == 0.0)
        return false;

    vec4 bounds = projected.ndcBounds;
    float gaussianDepth = -projected.viewCenter.z;
    // Four mip texels conservatively cover every potentially contributing pixel.
    ivec2 viewport = ivec2(frameInfo.viewportInfo.xy);
    ivec2 pixelMin = clamp(ivec2(floor((bounds.xy * 0.5 + 0.5) * vec2(viewport))),
        ivec2(0), viewport - 1);
    ivec2 pixelMax = clamp(ivec2(ceil((bounds.zw * 0.5 + 0.5) * vec2(viewport))) - 1,
        pixelMin, viewport - 1);
    int level = 0;
    int lastLevel = textureQueryLevels(hiZDepth) - 1;
    ivec2 cellMin = pixelMin;
    ivec2 cellMax = pixelMax;
    while (any(greaterThan(cellMax - cellMin, ivec2(1))) && level < lastLevel) {
        ++level;
        cellMin = pixelMin >> level;
        cellMax = pixelMax >> level;
    }
    if (any(greaterThan(cellMax - cellMin, ivec2(1))))
        return false;

    vec4 depths = vec4(texelFetch(hiZDepth, cellMin, level).r,
        texelFetch(hiZDepth, ivec2(cellMax.x, cellMin.y), level).r,
        texelFetch(hiZDepth, ivec2(cellMin.x, cellMax.y), level).r,
        texelFetch(hiZDepth, cellMax, level).r);
    float farthest = max(max(depths.x, depths.y), max(depths.z, depths.w));
    // Match the fragment test's 0.1 tolerance, with an additional conservative bias.
    float depthGuard = max(0.0001, gaussianDepth * 0.00001);
    if (gaussianDepth > farthest + 0.1 + depthGuard)
        return true;

    vec2 size = vec2(pixelMax - pixelMin + 1);
    if (frameInfo.extraInfo.z == 0.0 || level == 0 || size.x * size.y < HIZ_REFINE_MIN_PIXELS)
        return false;
    return refineOcclusion(projected, pixelMin, pixelMax, level, cellMin, cellMax, depths, depthGuard);
}

bool isFinite(vec4 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

uint encodeDepth(float viewZ)
{
    uint bits = floatBitsToUint(viewZ);
    // Ascending unsigned keys preserve ascending view z (far-to-near).
    return bits ^ ((bits & 0x80000000u) != 0u ? 0xFFFFFFFFu : 0x80000000u);
}

// Degree 3 SH in asset-local coordinates; coefficients are basis-major RGB.
// dir is the normalized camera-to-splat direction transformed into asset space.
vec3 evalSH3(vec3 dir, float sh[48])
{
    float x = dir.x, y = dir.y, z = dir.z;
    float xx = x*x, yy = y*y, zz = z*z;
    float xy = x*y, yz = y*z, xz = x*z;
    #define SH(k) vec3(sh[3*(k)+0], sh[3*(k)+1], sh[3*(k)+2])

    float SH_C0 = 0.28209479177387814;
    vec3 result = SH_C0 * SH(0);

    float SH_C1 = 0.4886025119029199;
    result += SH_C1 * (-y * SH(1) + z * SH(2) - x * SH(3));

    float C2_0 = 1.0925484305920792;
    float C2_1 = -1.0925484305920792;
    float C2_2 = 0.31539156525252005;
    float C2_3 = -1.0925484305920792;
    float C2_4 = 0.5462742152960396;
    float tmp0 = 3.0*zz - 1.0;
    result += C2_0 * (xy * SH(4)) + C2_1 * (yz * SH(5)) + C2_2 * (tmp0 * SH(6))
            + C2_3 * (xz * SH(7)) + C2_4 * ((xx - yy) * SH(8));

    float C3_0 = -0.5900435899266435;
    float C3_1 = 2.890611442640554;
    float C3_2 = -0.4570457994644658;
    float C3_3 = 0.3731763325901154;
    float C3_4 = -0.4570457994644658;
    float C3_5 = 1.445305721320277;
    float C3_6 = -0.5900435899266435;
    float tmp1 = 4.0*zz - xx - yy;
    float tmp2 = xx - yy;
    result += C3_0 * (y*(3.0*xx - yy) * SH(9))  + C3_1 * (xy*z * SH(10))
            + C3_2 * (y*tmp1 * SH(11))          + C3_3 * (z*(2.0*zz - 3.0*xx - 3.0*yy) * SH(12))
            + C3_4 * (x*tmp1 * SH(13))          + C3_5 * (z*tmp2 * SH(14))
            + C3_6 * (x*(xx - 3.0*yy) * SH(15));
    #undef SH
    return result + 0.5; // 3DGS 约定: 最终颜色 = 0.5 + SH_eval
}

bool projectAndCull(uint id, out ProjectedSplatGPU result, out uint key)
{
    key = 0u;
    GaussianDataGPU g = gaussians[id];
    if (!isFinite(g.posAndOpacity) ||
        g.posAndOpacity.w < frameInfo.extraInfo.x ||
        g.modelIndex >= uint(modelTransforms.length()))
        return false;

    mat4 model = modelTransforms[g.modelIndex];
    // Preserve the existing VS's separate model and view transformations.
    vec3 worldCenter = (model * vec4(g.posAndOpacity.xyz, 1.0)).xyz;
    vec4 viewCenter = camera.viewMatrix * vec4(worldCenter, 1.0);
    // LMG rejects centers at positive camera depth <= 0.2.
    if (!isFinite(viewCenter) || viewCenter.z >= -0.2)
        return false;

    vec4 clipCenter = camera.projectionMatrix * viewCenter;
    if (!isFinite(clipCenter) || clipCenter.w <= 0.0)
        return false;

    vec3 ndcCenter = clipCenter.xyz / clipCenter.w;
    /* Original center-depth clipping, retained for the old quad path.
    if (!isFinite(vec4(ndcCenter, 1.0)) ||
        ndcCenter.z < 0.0 || ndcCenter.z > 1.0)
        return false;
    */
    if (!isFinite(vec4(ndcCenter, 1.0)))
        return false;

    mat3 covariance = mat3(
        g.cov3d[0], g.cov3d[1], g.cov3d[2],
        g.cov3d[1], g.cov3d[3], g.cov3d[4],
        g.cov3d[2], g.cov3d[4], g.cov3d[5]
    );

    float fx = frameInfo.focal.x;
    float fy = frameInfo.focal.y;
    vec2 tanHalfFoV = frameInfo.viewportInfo.xy / (2.0 * abs(vec2(fx, fy)));
    vec2 limitedXY = clamp(viewCenter.xy / viewCenter.z, -1.3 * tanHalfFoV, 1.3 * tanHalfFoV)
        * viewCenter.z;
    float inverseZSquared = 1.0 / (viewCenter.z * viewCenter.z);
    /* Original unclamped projection Jacobian.
    mat3 jacobian = mat3(
        fx / viewCenter.z, 0.0, -(fx * viewCenter.x) * inverseZSquared,
        0.0, fy / viewCenter.z, -(fy * viewCenter.y) * inverseZSquared,
        0.0, 0.0, 0.0
    );
    */
    mat3 jacobian = mat3(
        fx / viewCenter.z, 0.0, -(fx * limitedXY.x) * inverseZSquared,
        0.0, fy / viewCenter.z, -(fy * limitedXY.y) * inverseZSquared,
        0.0, 0.0, 0.0
    );
    mat3 transform = transpose(mat3(camera.viewMatrix)) * jacobian;
    transform = transpose(mat3(model)) * transform;
    mat3 cov2D = transpose(transform) * covariance * transform;
    float splatScale = frameInfo.cameraPosAndScale.w;
    cov2D *= splatScale * splatScale;
    cov2D[0][0] += 0.3;
    cov2D[1][1] += 0.3;

    float a = cov2D[0][0];
    float b = cov2D[0][1];
    float d = cov2D[1][1];
    if (!isFinite(vec4(a, b, d, 0.0)))
        return false;

    float halfTrace = (a + d) * 0.5;
    float determinant = a * d - b * b;
    if (!isFinite(vec4(determinant, 0.0, 0.0, 0.0)) || determinant <= 0.0)
        return false;

    // Original rotated sqrt(8) quad and fixed radius cap, retained for comparison.
    /*
    float term = sqrt(max(0.0, halfTrace * halfTrace - determinant));
    float lambda1 = halfTrace + term;
    float lambda2 = halfTrace - term;
    if (!isFinite(vec4(lambda1, lambda2, 0.0, 0.0)) || lambda2 <= 0.0)
        return false;

    vec2 eigenvector1;
    if (abs(b) > 0.001)
        eigenvector1 = normalize(vec2(lambda1 - d, b));
    else
        eigenvector1 = a >= d ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    vec2 eigenvector2 = vec2(-eigenvector1.y, eigenvector1.x);

    // Keep the low-pass filter, radius cap and splatScale order identical to VS.
    float splatScale = frameInfo.cameraPosAndScale.w;
    vec2 basis1 = eigenvector1 * splatScale * min(SQRT8 * sqrt(lambda1), 2048.0);
    vec2 basis2 = eigenvector2 * splatScale * min(SQRT8 * sqrt(lambda2), 2048.0);
    basis1 = basis1 * frameInfo.viewportInfo.zw * 2.0;
    basis2 = basis2 * frameInfo.viewportInfo.zw * 2.0;
