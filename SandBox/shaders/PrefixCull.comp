    result.ndcCenter = vec4(ndcCenter, 1.0);
    // result.ndcBasis = vec4(basis1, basis2);
    result.ndcBasis = compactBasis;
    // SH coefficients stay in asset space when the instance is transformed.
    vec3 camPos = frameInfo.cameraPosAndScale.xyz;
    vec3 viewDir = normalize(inverse(mat3(model)) * (worldCenter - camPos));
    vec3 shColor = evalSH3(viewDir, g.sh);
    result.color = vec4(max(shColor, vec3(0.0)), g.posAndOpacity.w);
    // result.viewCenter = vec4(E, 0.0);
    // result.invSigma0 = inverse0;
    // result.invSigma1 = inverseTail;
    result.viewCenter = vec4(viewCenter.xyz, 0.0);
    vec2 quadExtent = abs(compactBasis.xy) + abs(compactBasis.zw);
    bool needsTileClip = any(lessThan(quadCenter - quadExtent, vec2(ndcMin))) ||
        any(greaterThan(quadCenter + quadExtent, vec2(ndcMax)));
    result.quadCenter = vec4(quadCenter, needsTileClip ? 1.0 : 0.0, 0.0);
    result.tileBounds = vec4(ndcMin, ndcMax);
    result.conic = vec4(conic, -0.5 * supportRadiusSquared);
    result.ndcBounds = compactBounds;
    key = encodeDepth(viewCenter.z);
    return true;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    // Avoid OpArrayLength on the potentially >2 GiB Gaussian SSBO.
    bool inRange = id < workInfo.counts.z;
    bool visible = false;
    bool frustumVisible = false;
    uint key = 0u;
    ProjectedSplatGPU projected;
    if (inRange)
    {
        frustumVisible = projectAndCull(id, projected, key);
        visible = frustumVisible;
        if (visible && isOccluded(projected))
            visible = false;
        if (visible)
            projectedSplats[id] = projected;
    }

    // Padded lanes still participate in every barrier of the inclusive scan.
    visiblePrefix[lane] = uvec2(visible ? 1u : 0u, frustumVisible ? 1u : 0u);
    barrier();
    for (uint stride = 1u; stride < 512u; stride <<= 1u)
    {
        uvec2 value = visiblePrefix[lane];
        if (lane >= stride)
            value += visiblePrefix[lane - stride];
        barrier();
        visiblePrefix[lane] = value;
        barrier();
    }

    if (inRange)
        prefixScratch[id] = uvec2(key, visible ? visiblePrefix[lane].x - 1u : INVALID_RANK);
    if (lane == 511u)
        groupData[gl_WorkGroupID.x] = visiblePrefix[lane];
}
