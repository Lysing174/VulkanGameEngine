#version 460

layout(local_size_x = 256) in;

// Push constants: view matrix + projection matrix (no UBO needed)
layout(push_constant) uniform PushConstants
{
    mat4 viewMatrix;
    mat4 projectionMatrix;
};

// Gaussian data SSBO
struct GaussianDataGPU
{
    vec4  posAndOpacity;  // xyz = position, w = opacity
    vec4  color;          // rgb, w = unused
    float cov3d[6];
    uint  modelIndex;     // index into model transform SSBO
    float _pad1;
};

layout(set = 0, binding = 0, std430) readonly buffer GaussianDataBuffer
{
    GaussianDataGPU gaussians[];
};

// Output: distances (keys) and indices (values)
layout(set = 0, binding = 1, std430) writeonly buffer DistancesBuffer
{
    uint distances[];
};

layout(set = 0, binding = 2, std430) writeonly buffer IndicesBuffer
{
    uint indices[];
};

// Model transform SSBO: one mat4 per model
layout(set = 0, binding = 3, std430) readonly buffer ModelTransformBuffer
{
    mat4 modelTransforms[];
};

// Encodes an fp32 into a uint32 that sorts correctly as unsigned integer
uint encodeMinMaxFp32(float val)
{
    uint bits = floatBitsToUint(val);
    bits ^= (int(bits) >> 31) | 0x80000000u;
    return bits;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= gaussians.length())
        return;

    // Get model transform and apply to position
    uint mIdx = gaussians[id].modelIndex;
    vec4 pos = vec4(gaussians[id].posAndOpacity.xyz, 1.0);
    pos = modelTransforms[mIdx] * pos;  // local -> world

    // Project splat center to NDC
//    pos = projectionMatrix * viewMatrix * pos;
//    pos = pos / pos.w;
//
//    // Encode -depth: sorting ascending = far-to-near (back-to-front for alpha blend)
//    distances[id] = encodeMinMaxFp32(-pos.z);
    vec4 viewPos = viewMatrix * (modelTransforms[mIdx] * vec4(gaussians[id].posAndOpacity.xyz, 1.0));
    // view space中，相机看向-z方向，越远z越负
    // 排序far-to-near：对(-z)降序，即对z升序
    // encodeMinMaxFp32(-viewPos.z) 就是正确的（z为负，-z为正）
    distances[id] = encodeMinMaxFp32(viewPos.z);
    indices[id] = id;
}
