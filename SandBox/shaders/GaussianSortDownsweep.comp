#version 460

// Radix Sort - Downsweep Phase (Key-Value Scatter)
//
// Each workgroup processes a partition of 512 elements.
// For each element:
//   1. Extract the 8-bit digit for this pass
//   2. Compute a DETERMINISTIC local rank via two-level prefix scan:
//        - Level 1: count digits per sub-group (32 threads) via atomicAdd
//        - Level 2: prefix sum across sub-groups + linear scan within sub-group
//   3. outIdx = partitionHistogram[partition * 256 + digit]  (global base offset)
//             + localRank                                     (position within partition)
//
// Why not atomicAdd for scatter?
//   atomicAdd on digitOffset gives non-deterministic ordering within the same
//   digit group each frame. Alpha-blended splats drawn in different orders
//   produce different colours -> flickering. The two-level scan below
//   guarantees the same element always lands in the same output slot.

layout(local_size_x = 512) in;

layout(push_constant) uniform PushConstants
{
    uint passNum;        // which 8-bit pass (0-3 for 32-bit keys)
    uint elementCount;
    uint numPartitions;
    uint pad0;
};

layout(set = 0, binding = 0, std430) readonly buffer KeysIn      { uint keysIn[];   };
layout(set = 0, binding = 1, std430) readonly buffer ValuesIn    { uint valuesIn[]; };
layout(set = 0, binding = 2, std430) readonly buffer PartitionHistogram
{
    // After Spine pass: partitionHistogram[p * 256 + d] =
    //   global output offset for (partition p, digit d)
    uint partitionHistogram[];
};
layout(set = 0, binding = 3, std430) writeonly buffer KeysOut    { uint keysOut[];   };
layout(set = 0, binding = 4, std430) writeonly buffer ValuesOut  { uint valuesOut[]; };

// ---- Shared memory layout ----
//
// threadDigit[512]          - digit extracted by each thread (256 = invalid sentinel)
// subgroupHist[16 * 256]    - per-subgroup digit counts (16 subgroups of 32 threads)
//
// subgroupHist[g * 256 + d] = number of threads in subgroup g that have digit d

shared uint threadDigit[512];
shared uint subgroupHist[16 * 256];   // 16 subgroups * 256 digits = 4096 uints (16 KB)

void main()
{
    uint localId     = gl_LocalInvocationID.x;   // 0..511
    uint workgroupId = gl_WorkGroupID.x;
    uint baseIdx     = workgroupId * 512u;

    uint subgroupId  = localId / 32u;            // 0..15
    uint laneId      = localId % 32u;            // 0..31

    uint myIdx = baseIdx + localId;
    bool valid = (myIdx < elementCount);

    // -----------------------------------------------------------------------
    // Phase 1 - Extract digit and store in shared memory
    // -----------------------------------------------------------------------
    uint key   = valid ? keysIn[myIdx] : 0u;
    uint digit = valid ? ((key >> (passNum * 8u)) & 0xFFu) : 256u;  // 256 = sentinel

    threadDigit[localId] = digit;

    // -----------------------------------------------------------------------
    // Phase 2 - Zero subgroup histograms
    // -----------------------------------------------------------------------
    // 16 * 256 = 4096 entries, 512 threads → each clears 8 entries
    for (uint i = localId; i < 16u * 256u; i += 512u)
        subgroupHist[i] = 0u;

    memoryBarrierShared();
    barrier();

    // -----------------------------------------------------------------------
    // Phase 3 - Accumulate per-subgroup digit counts
    //   atomicAdd is safe here: we only need counts, not positions
    // -----------------------------------------------------------------------
    if (valid)
        atomicAdd(subgroupHist[subgroupId * 256u + digit], 1u);

    memoryBarrierShared();
    barrier();

    // -----------------------------------------------------------------------
    // Phase 4 - Compute deterministic local rank and scatter
    //
    //   localRank = (sum of counts for this digit in all EARLIER subgroups)
    //             + (number of threads in MY subgroup with this digit and localId < mine)
    //
    //   This is a stable sort by localId, so the same element always gets
    //   the same rank → no flickering.
    // -----------------------------------------------------------------------
    if (valid)
    {
        // 4a: prefix sum over earlier subgroups for this digit  (O(16) loop)
        uint rankFromPrevSubgroups = 0u;
        for (uint g = 0u; g < subgroupId; g++)
            rankFromPrevSubgroups += subgroupHist[g * 256u + digit];

        // 4b: linear scan within current subgroup for threads with the same digit
        //     that have a smaller localId  (O(32) loop, fully in shared mem)
        uint subgroupBase = subgroupId * 32u;
        uint rankInSubgroup = 0u;
        for (uint j = subgroupBase; j < localId; j++)
        {
            if (threadDigit[j] == digit)
                rankInSubgroup++;
        }

        // 4c: scatter
        uint localRank = rankFromPrevSubgroups + rankInSubgroup;
        uint globalBase = partitionHistogram[workgroupId * 256u + digit];
        uint outIdx = globalBase + localRank;

        keysOut[outIdx]   = key;
        valuesOut[outIdx] = valuesIn[myIdx];
    }
}
