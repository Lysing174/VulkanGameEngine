#version 460

// Radix Sort - Spine Phase
//
// Single workgroup, 256 threads (one per digit).
//
// Step 1: Exclusive prefix sum over globalHistogram[passNum*256 .. passNum*256+255]
//         → tells each digit where in the output array its block starts.
//
// Step 2: For each digit, walk all partitions in order and compute the
//         exclusive prefix sum of partitionHistogram[p*256+digit] across p.
//         Write the result back so that after this pass:
//           partitionHistogram[p * 256 + d] =
//             global output base for (partition p, digit d)
//
// Race-condition fix vs original:
//   The original converted inclusive→exclusive by reading sharedPrefix[digit-1]
//   while other threads might already be writing sharedPrefix[digit], causing
//   a data race.  Fix: use two separate shared arrays so the read phase and
//   write phase never touch the same array simultaneously.

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants
{
    uint passNum;
    uint elementCount;
    uint numPartitions;
    uint pad0;
};

layout(set = 0, binding = 1, std430) buffer GlobalHistogram
{
    // [passNum * 256 + digit] = total count of elements with that digit (input)
    // After this shader: converted to exclusive prefix sum (output)
    uint globalHistogram[];
};

layout(set = 0, binding = 2, std430) buffer PartitionHistogram
{
    // [p * 256 + digit] = count in partition p for that digit (input)
    // After this shader: global output offset for (partition p, digit) (output)
    uint partitionHistogram[];
};

shared uint sInclusive[256];   // Kogge-Stone intermediate (inclusive sums)
shared uint sExclusive[256];   // final exclusive prefix sums (separate array → no race)

void main()
{
    uint digit = gl_LocalInvocationID.x;   // 0..255

    // -----------------------------------------------------------------------
    // Step 1a: Load global histogram counts into shared memory
    // -----------------------------------------------------------------------
    sInclusive[digit] = globalHistogram[passNum * 256u + digit];
    memoryBarrierShared();
    barrier();

    // -----------------------------------------------------------------------
    // Step 1b: Kogge-Stone inclusive prefix sum
    //   After loop: sInclusive[d] = sum of counts for digits 0..d (inclusive)
    //
    //   Each stride: read TWO values from the PREVIOUS iteration's sInclusive,
    //   barrier, THEN write.  Using a local accumulator avoids reading a slot
    //   that another thread is simultaneously writing.
    // -----------------------------------------------------------------------
    for (uint stride = 1u; stride < 256u; stride *= 2u)
    {
        uint val = sInclusive[digit];
        if (digit >= stride)
            val += sInclusive[digit - stride];
        memoryBarrierShared();
        barrier();
        sInclusive[digit] = val;
        memoryBarrierShared();
        barrier();
    }

    // -----------------------------------------------------------------------
    // Step 1c: Convert inclusive → exclusive into a SEPARATE array
    //   sExclusive[d] = sum of counts for digits 0..(d-1)
    //   sExclusive[0] = 0
    //   No race: we only READ sInclusive here, we only WRITE sExclusive.
    // -----------------------------------------------------------------------
    sExclusive[digit] = (digit > 0u) ? sInclusive[digit - 1u] : 0u;
    memoryBarrierShared();
    barrier();

    // Write back exclusive prefix sum to global histogram
    globalHistogram[passNum * 256u + digit] = sExclusive[digit];

    // -----------------------------------------------------------------------
    // Step 2: Compute exclusive prefix sum over partitions for this digit.
    //   Serial loop: numPartitions is small (typically < 1024).
    //   sExclusive[digit] is this digit's global starting offset.
    // -----------------------------------------------------------------------
    uint runningSum = 0u;
    for (uint p = 0u; p < numPartitions; p++)
    {
        uint count = partitionHistogram[p * 256u + digit];
        partitionHistogram[p * 256u + digit] = sExclusive[digit] + runningSum;
        runningSum += count;
    }
    // (No barrier needed here: each thread writes a disjoint set of slots.)
}
